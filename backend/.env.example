# Arquivo de exemplo de variáveis de ambiente para o backend
# Copie este arquivo para .env e ajuste antes de rodar em produção.

PORT=3333
NODE_ENV=development
JWT_SECRET=uma_chave_secreta_segura_aqui

# Opcional: dados do usuário administrador de desenvolvimento
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@exemplo.com
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_NAME=Administrador
