rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.token.email == 'elias@test.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isTestPublisher() {
      return signedIn()
        && request.auth.token.email == 'elias+comprador@test.com';
    }

    function subscriptionPath(userId) {
      return /databases/$(database)/documents/subscriptions/$(userId);
    }

    function hasActiveLevelTwoSubscription() {
      return signedIn()
        && exists(subscriptionPath(request.auth.uid))
        && get(subscriptionPath(request.auth.uid)).data.level == 2
        && get(subscriptionPath(request.auth.uid)).data.status == 'active'
        && get(subscriptionPath(request.auth.uid)).data.expiresAt > request.time;
    }

    function canPublishInCategory(category) {
      return isAdmin()
        || (hasActiveLevelTwoSubscription()
          && get(subscriptionPath(request.auth.uid)).data.category == category);
    }

    match /admins/{userId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        || (isTestPublisher()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.rentalPrice == 100
          && request.resource.data.rentalDays == 30)
        || (signedIn()
          && request.resource.data.type == 'purchase_request'
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId in get(
            /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
          ).data.participantIds)
        || (signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId in get(
            /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
          ).data.participantIds);
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId;
      allow delete: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /support/{documentId} {
      allow read: if documentId == 'config';
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && canPublishInCategory(request.resource.data.category)
          && request.resource.data.rentalPrice == 100
          && request.resource.data.rentalDays == 30
          && request.resource.data.rentalExpiresAt > request.time);
      allow update, delete: if signedIn()
        && (isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == request.auth.uid
            && canPublishInCategory(request.resource.data.category)));
    }

    match /conversations/{conversationId} {
      allow read, update: if signedIn()
        && (isAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if signedIn()
        && (isAdmin() || request.auth.uid in request.resource.data.participantIds);

      match /messages/{messageId} {
        allow read, create: if signedIn()
          && (isAdmin() || request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
